{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-settings/main/schema.json",
  "productName": "EISMaster",
  "version": "0.1.0",
  "identifier": "com.eismaster.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EISMaster",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../../matlab_bridge": "matlab_bridge/",
      "../../../../matlab-DRTtools-local": "matlab-DRTtools-local/"
    }
  }
}
